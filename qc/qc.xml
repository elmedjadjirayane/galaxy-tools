<tool id="quality_control" name="Quality control for GWAS analysis" version="1.0.4" profile="24.0">
    <description>
        Run quality control on genotype data for GWAS analysis.
    </description>
    <requirements>
        <requirement type="package" version="2.00a2.3">
            plink2
        </requirement>
        <requirement type="package" version="1.90b6.12">
            plink
        </requirement>
    </requirements>
    <command><![CDATA[
    bash '$__tool_directory__/qc.sh' 
        '$vcf_file'
        '$pheno_file'
        '$maf_threshold'
        '$hwe_threshold'
        '$mgcf_threshold'
        '$max_heterozygosity'
        #if '$performLDcond.performLD':
            '$performLDcond.window_size'
            '$performLDcond.step_size'
            '$performLDcond.ld_threshold'
        #end if
        '$pbed_output'
        '$__tool_directory__'
        '$performLDcond.performLD'
        '$fid'
]]>
    </command>
    <inputs>
        <param name="vcf_file" type="data" format="vcf_bgzip"/>
        <param name="fid" type="boolean" checked="true" label="Family ID column" help="Yes if phenotype file has Family ID column, else No. (The format is what is expected by Plink1.9)"/>
        <param name="pheno_file" type="data" format="tabular"/>
        <param name="maf_threshold" type="float" value="0" min="0" max="0.5" label="maf Threshold value" help="Set the threshold for minor allele frequency"/>
        <param name="hwe_threshold" type="float" value="1" min="0" max="1" label="hwe Threshold value" help="Set the threshold for Hardy-Weinberg equilibrium"/>
        <param name="mgcf_threshold" type="float" value="0" min="0" max="0.33" label="mgcf Threshold value" help="Set the threshold for minor genotypic class frequency"/>
        <param name="max_heterozygosity" type="float" value="1" min="0" max="1" label="max heterozygosity Threshold value" help="Set the threshold for heterozygosity"/>
        <conditional name="performLDcond">
            <param name="performLD" type="select" label="Do you want to perform LD pruning?">
                <option value="true" selected="true">Yes</option>
                <option value="false">No</option>
            </param>
            <when value="true">
                <param name="ld_threshold" type="float" value="0.99" min="0" max="1" label="LD Threshold value" help="Set the threshold for LD."/>
                <param name="window_size" type="float" value="50" min="10" max="500" label="Window size" help="Set the window size for LD pruning."/>
                <param name="step_size" type="float" value="5" min="1" max="10" label="Step size" help="Set the step size for LD pruning."/>
            </when>
            <when value="false">
                <param name="ld_threshold" type="float" value="-1" label="LD Threshold value" help="Set the threshold for LD."/>
                <param name="window_size" type="float" value="-1" label="Window size" help="Set the window size for LD pruning."/>
                <param name="step_size" type="float" value="-1" label="Step size" help="Set the step size for LD pruning."/>
            </when>
        </conditional>
    </inputs>
    <outputs>
        <data name="pbed_output" format="pbed"/>
    </outputs>
    <tests>
        <test>
            <param name="fid" value="true"/>
            <param name="vcf_file" value="geno.vcf_bgzip" ftype="vcf_bgzip"/>
            <param name="pheno_file" value="pheno.tabular" ftype="tabular"/>
            <param name="maf_threshold" value="0"/>
            <param name="hwe_threshold" value="0"/>
            <param name="mgcf_threshold" value="0"/>
            <param name="max_heterozygosity" value="1"/>
            <conditional name="performLDcond">
                <param name="performLD" value="true"/>
                <param name="ld_threshold" value="0.9999999"/>
                <param name="window_size" value="50"/>
                <param name="step_size" value="5"/>
            </conditional>
            <output name="pbed_output" file="final.html" ftype="pbed">
                <extra_files type="file" name="RgeneticsData.bim" value="final.bim"/>
                <extra_files type="file" name="RgeneticsData.bed" value="final.bed"/>
                <extra_files type="file" name="RgeneticsData.fam" value="final.fam"/>
            </output>
        </test>
        <test>
            <param name="fid" value="false"/>
            <param name="vcf_file" value="geno.vcf_bgzip" ftype="vcf_bgzip"/>
            <param name="pheno_file" value="pheno_nocol.tabular" ftype="tabular"/>
            <param name="maf_threshold" value="0"/>
            <param name="hwe_threshold" value="0"/>
            <param name="mgcf_threshold" value="0"/>
            <param name="max_heterozygosity" value="1"/>
            <conditional name="performLDcond">
                <param name="performLD" value="true"/>
                <param name="ld_threshold" value="0.9999999"/>
                <param name="window_size" value="50"/>
                <param name="step_size" value="5"/>
            </conditional>
            <output name="pbed_output" file="final.html" ftype="pbed">
                <extra_files type="file" name="RgeneticsData.bim" value="final.bim"/>
                <extra_files type="file" name="RgeneticsData.bed" value="final.bed"/>
                <extra_files type="file" name="RgeneticsData.fam" value="final_nocol.fam"/>
            </output>
        </test>
        <test>
            <param name="fid" value="false"/>
            <param name="vcf_file" value="geno.vcf_bgzip" ftype="vcf_bgzip"/>
            <param name="pheno_file" value="pheno_nocol_empty.tabular" ftype="tabular"/>
            <param name="maf_threshold" value="0"/>
            <param name="hwe_threshold" value="0"/>
            <param name="mgcf_threshold" value="0"/>
            <param name="max_heterozygosity" value="1"/>
            <conditional name="performLDcond">
                <param name="performLD" value="true"/>
                <param name="ld_threshold" value="0.9999999"/>
                <param name="window_size" value="50"/>
                <param name="step_size" value="5"/>
            </conditional>
            <output name="pbed_output" file="final.html" ftype="pbed">
                <extra_files type="file" name="RgeneticsData.bim" value="final.bim"/>
                <extra_files type="file" name="RgeneticsData.bed" value="final.bed"/>
                <extra_files type="file" name="RgeneticsData.fam" value="final_nocol_empty.fam"/>
            </output>
        </test>
        <test>
            <param name="fid" value="true"/>
            <param name="vcf_file" value="geno_extra-chr.vcf_bgzip" ftype="vcf_bgzip"/>
            <param name="pheno_file" value="pheno.tabular" ftype="tabular"/>
            <param name="maf_threshold" value="0"/>
            <param name="hwe_threshold" value="0"/>
            <param name="mgcf_threshold" value="0"/>
            <param name="max_heterozygosity" value="1"/>
            <conditional name="performLDcond">
                <param name="performLD" value="true"/>
                <param name="ld_threshold" value="0.9999999"/>
                <param name="window_size" value="50"/>
                <param name="step_size" value="5"/>
            </conditional>
            <output name="pbed_output" file="final.html" ftype="pbed">
                <extra_files type="file" name="RgeneticsData.bim" value="final_extra-chr.bim"/>
                <extra_files type="file" name="RgeneticsData.bed" value="final_extra-chr.bed"/>
                <extra_files type="file" name="RgeneticsData.fam" value="final_extra-chr.fam"/>
            </output>
        </test>
    </tests>
    <help>
        plink is a free, open-source whole genome association analysis toolset, designed to perform a range of basic, large-scale analyses in a computationally efficient manner.
        For detailed usage notes, visit http://www.cog-genomics.org/plink/1.9/
    </help>
    <citations>
        <citation type="doi">
            10.1186/s13742-015-0047-8
        </citation>
    </citations>
</tool>
